{
  "name": "alam-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.10.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "leaflet": "^1.9.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@capacitor/background-runner@3.0.0": true
  }
}
